# Export these variables before npm start. This app does not auto-load .env files.
NODE_ENV=development
PORT=3000
TZ=Asia/Manila
DATA_DIR=./data
PUBLIC_ORIGIN=http://localhost:3000
# Required for the operator login. Set a unique password of at least 16 characters.
CONSOLE_USERNAME=owner
CONSOLE_PASSWORD=
# Railway: NODE_ENV=production, DATA_DIR=/data, PUBLIC_ORIGIN=https://relax.afkcube.com

# Independent random secrets; keep values in the deployment secret manager only.
BACKUP_KEY=
RELAX_MONITOR_TOKEN=
